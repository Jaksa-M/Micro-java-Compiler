package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;

// import java.io.*;
import rs.ac.bg.etf.pp1.ast.*;


parser code {:
	
	boolean errorDetected = false;
	
	Logger log = Logger.getLogger(getClass());
   
   
    // slede redefinisani metodi za prijavu gresaka radi izmene teksta poruke
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	errorDetected = true;
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }
    
    public void report_info(String message, Object info) {
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.info(msg.toString());
    }
    
:}

// Code that asks from yylex class next token and tried to pair it with grammar.
scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}


// Terminals
terminal PROGRAM, BREAK, CLASS, ELSE, CONST, IF, NEW, PRINT, READ, RETURN, VOID, EXTENDS, CONTINUE, SET, UNION, DO, WHILE, MAP, INTERFACE;
terminal PLUS, MINUS, MULTIPLY, DIVIDE, MODUO, EQUAL, NOT_EQUAL, GREATER, GREATER_EQUAL, LESS, LESS_EQUAL;
terminal AND, OR, ASSIGNMENT, INC, DEC, SEMI, COLON, COMMA, POINT;
terminal LEFT_ROUND_BRACKET, RIGHT_ROUND_BRACKET, LEFT_SQUARE_BRACKET, RIGHT_SQUARE_BRACKET, LEFT_CURLY_BRACKET, RIGHT_CURLY_BRACKET;
// When type is specified, than those leaf nodes will be saved. If not specified they won't.
terminal Character CHAR_CONST;
terminal Integer NUMBER, BOOL_CONST;
terminal String IDENT;

// Non terminals
nonterminal Program Program;
nonterminal ConstDecl ConstDecl;
nonterminal VarDecl VarDecl;
nonterminal ClassDecl ClassDecl;
nonterminal InterfaceDecl InterfaceDecl;
nonterminal MethodSignature MethodSignature;
nonterminal MethodDecl MethodDecl;
nonterminal FormPars FormPars;
nonterminal Statement Statement;
nonterminal DesignatorStatement DesignatorStatement;
nonterminal ActPars ActPars;
nonterminal Label Label;
nonterminal Assignop Assignop;
nonterminal Relop Relop;
nonterminal Addop Addop;
nonterminal Mulop Mulop;
nonterminal Setop Setop;
// When type is specified, that class (and all derived classes) will get one more additional field of that type(Struct/Obj)
nonterminal rs.etf.pp1.symboltable.concepts.Struct Factor;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Expr;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Term;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Condition;
nonterminal rs.etf.pp1.symboltable.concepts.Struct CondTerm;
nonterminal rs.etf.pp1.symboltable.concepts.Struct CondFact;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Type;
nonterminal rs.etf.pp1.symboltable.concepts.Obj Designator;

// My custom nonTerminals
nonterminal AllDeclarationsList AllDeclarationsList;
nonterminal ConstAssignedVal ConstAssignedVal;
nonterminal MoreSingleLineConstDeclarations MoreSingleLineConstDeclarations;
nonterminal VarDeclList VarDeclList;
nonterminal MethodDeclList MethodDeclList;
nonterminal MethodVarDeclList MethodVarDeclList;
nonterminal FormParsTypeIdentList FormParsTypeIdentList;
nonterminal StatementList StatementList;
nonterminal StatementArrayBrackets StatementArrayBrackets;
nonterminal ActParsExprList ActParsExprList;
nonterminal ConstValueAssignment ConstValueAssignment;
nonterminal VarDeclAssignment VarDeclAssignment;
nonterminal ActPar ActPar;
nonterminal DoHelper DoHelper;
nonterminal ActParsHelper ActParsHelper;
nonterminal ElseHelper ElseHelper;
nonterminal WhileHelper WhileHelper;
nonterminal ProgramName ProgramName;
nonterminal FormParsTypeName FormParsTypeName;
nonterminal VarDeclLast VarDeclLast;
nonterminal VarDeclNotLast VarDeclNotLast;

nonterminal rs.etf.pp1.symboltable.concepts.Struct TermMulopFactorList;
nonterminal rs.etf.pp1.symboltable.concepts.Struct ExprAddopTermList;
nonterminal rs.etf.pp1.symboltable.concepts.Struct ConditionCondTermList;
nonterminal rs.etf.pp1.symboltable.concepts.Struct CondTermCondFactList;
nonterminal rs.etf.pp1.symboltable.concepts.Obj DesignatorArrayName;
nonterminal rs.etf.pp1.symboltable.concepts.Obj MethodSignatureTypeName;


// precedences
precedence left ELSE;

// Grammar

Program ::= (Program) PROGRAM ProgramName:P1 AllDeclarationsList:A2 LEFT_CURLY_BRACKET MethodDeclList:M3 RIGHT_CURLY_BRACKET {: RESULT=new Program(P1, A2, M3); RESULT.setLine(P1left); :};

ProgramName ::= (ProgramName) IDENT:I1 {: RESULT=new ProgramName(I1); RESULT.setLine(I1left); :};

AllDeclarationsList ::=   (ConstDeclarations) AllDeclarationsList:A1 ConstDecl:C2 {: RESULT=new ConstDeclarations(A1, C2); RESULT.setLine(A1left); :}
						| (VarDeclarations) AllDeclarationsList:A1 VarDecl:V2 {: RESULT=new VarDeclarations(A1, V2); RESULT.setLine(A1left); :}
						| (NoDeclarations) {: RESULT=new NoDeclarations(); :} // epsilon
						;


ConstDecl ::= (ConstDecl) CONST Type:T1 ConstValueAssignment:C2 MoreSingleLineConstDeclarations:M3 SEMI {: RESULT=new ConstDecl(T1, C2, M3); RESULT.setLine(T1left); :};

ConstValueAssignment ::= (ConstValueAssignment) IDENT:I1 ASSIGNMENT ConstAssignedVal:C2 {: RESULT=new ConstValueAssignment(I1, C2); RESULT.setLine(I1left); :};

ConstAssignedVal ::=    (ConstIntegerValue) NUMBER:N1 {: RESULT=new ConstIntegerValue(N1); RESULT.setLine(N1left); :}
					  | (ConstCharValue) CHAR_CONST:C1 {: RESULT=new ConstCharValue(C1); RESULT.setLine(C1left); :}
			   		  | (ConstBooleanValue) BOOL_CONST:B1 {: RESULT=new ConstBooleanValue(B1); RESULT.setLine(B1left); :}
			   		  ;

MoreSingleLineConstDeclarations ::=   (MoreConstDeclarations) MoreSingleLineConstDeclarations:M1 COMMA ConstValueAssignment:C2 {: RESULT=new MoreConstDeclarations(M1, C2); RESULT.setLine(M1left); :}
									| (NoMoreConstDeclarations) {: RESULT=new NoMoreConstDeclarations(); :}; // epsilon


VarDecl ::=   (VarDeclNormal) Type:T1 VarDeclList:V2 {: RESULT=new VarDeclNormal(T1, V2); RESULT.setLine(T1left); :}
			| (VarDeclNormalError) error:e {:parser.report_error("Oporavak od greske [VarDecl] na liniji " + eleft, null);:} SEMI {: RESULT=new VarDeclNormalError(); :}
			;

VarDeclList ::=   (VarDeclListMultiple) VarDeclNotLast:V1 VarDeclList:V2 {: RESULT=new VarDeclListMultiple(V1, V2); RESULT.setLine(V1left); :}
				| (VarDeclListLast) VarDeclLast:V1 {: RESULT=new VarDeclListLast(V1); RESULT.setLine(V1left); :}
				;

VarDeclAssignment ::=   (VarDeclAssignmentVariable) IDENT:I1 {: RESULT=new VarDeclAssignmentVariable(I1); RESULT.setLine(I1left); :}
					  | (VarDeclAssignmentArray) IDENT:I1 LEFT_SQUARE_BRACKET RIGHT_SQUARE_BRACKET {: RESULT=new VarDeclAssignmentArray(I1); RESULT.setLine(I1left); :}
					  ;

VarDeclNotLast ::=   (VarDeclNotLast1) VarDeclAssignment:V1 COMMA {: RESULT=new VarDeclNotLast1(V1); RESULT.setLine(V1left); :}
   				   | (VarDeclNotLast1Error) error:e {: parser.report_error("Oporavak od greske do ',' na liniji " + eleft, null); :} COMMA {: RESULT=new VarDeclNotLast1Error(); :}
				   ;

VarDeclLast ::=   (VarDeclLast1) VarDeclAssignment:V1 SEMI {: RESULT=new VarDeclLast1(V1); RESULT.setLine(V1left); :}
				| (VarDeclLast1Error) error:e {: parser.report_error("Oporavak od greske do ';' na liniji " + eleft, null); :} SEMI {: RESULT=new VarDeclLast1Error(); :}
				;


Type ::= (Type) IDENT:I1 {: RESULT=new Type(I1); RESULT.setLine(I1left); :};


MethodDeclList ::=   (MethodDeclList1) MethodDeclList:M1 MethodDecl:M2 {: RESULT=new MethodDeclList1(M1, M2); RESULT.setLine(M1left); :}
				   | (EmptyMethodDeclList1) {: RESULT=new EmptyMethodDeclList1(); :}; // epsilon

MethodDecl ::= (MethodDecl) MethodSignature:M1 MethodVarDeclList:M2 LEFT_CURLY_BRACKET StatementList:S3 RIGHT_CURLY_BRACKET {: RESULT=new MethodDecl(M1, M2, S3); RESULT.setLine(M1left); :};

MethodSignature ::=   (MethodSignatureFormPars) MethodSignatureTypeName:M1 LEFT_ROUND_BRACKET FormPars:F2 {: RESULT=new MethodSignatureFormPars(M1, F2); RESULT.setLine(M1left); :} 
					| (MethodSignatureEmpty) MethodSignatureTypeName:M1 LEFT_ROUND_BRACKET RIGHT_ROUND_BRACKET {: RESULT=new MethodSignatureEmpty(M1); RESULT.setLine(M1left); :}
					;
					
MethodSignatureTypeName ::=   (MethodSignatureTypeNameType) Type:T1 IDENT:I2 {: RESULT=new MethodSignatureTypeNameType(T1, I2); RESULT.setLine(T1left); :}
							| (MethodSignatureTypeNameVoid) VOID IDENT:I1 {: RESULT=new MethodSignatureTypeNameVoid(I1); RESULT.setLine(I1left); :}
							;
					
MethodVarDeclList ::=   (MethodVarDeclList1) MethodVarDeclList:M1 VarDecl:V2 {: RESULT=new MethodVarDeclList1(M1, V2); RESULT.setLine(M1left); :}
					  | (EmptyMethodVarDeclList1) {: RESULT=new EmptyMethodVarDeclList1(); :}; // epsilon


FormPars ::= (FormPars) FormParsTypeIdentList:F1 {: RESULT=new FormPars(F1); RESULT.setLine(F1left); :};

FormParsTypeName ::=   (FormParsTypeNameVariable) Type:T1 IDENT:I2 {: RESULT=new FormParsTypeNameVariable(T1, I2); RESULT.setLine(T1left); :}
					 | (FormParsTypeNameArray) Type:T1 IDENT:I2 LEFT_SQUARE_BRACKET RIGHT_SQUARE_BRACKET {: RESULT=new FormParsTypeNameArray(T1, I2); RESULT.setLine(T1left); :}
					 ;

FormParsTypeIdentList ::=   (FormParsTypeIdentList1) FormParsTypeName:F1 COMMA FormParsTypeIdentList:F2 {: RESULT=new FormParsTypeIdentList1(F1, F2); RESULT.setLine(F1left); :}
						  | (FormParsTypeIdentList1Error) error:e {: parser.report_error("Oporavak od greske [FormPars] do ',' na liniji " + eleft, null); :} COMMA FormParsTypeIdentList:F1 {: RESULT=new FormParsTypeIdentList1Error(F1); RESULT.setLine(F1left); :}
					      | (EmptyFormParsTypeIdentList1) FormParsTypeName:F1 RIGHT_ROUND_BRACKET {: RESULT=new EmptyFormParsTypeIdentList1(F1); RESULT.setLine(F1left); :}
					      | (EmptyFormParsTypeIdentList1Error) error:e {: parser.report_error("Oporavak od greske [FormPars] do ')' na liniji " + eleft, null); :} RIGHT_ROUND_BRACKET {: RESULT=new EmptyFormParsTypeIdentList1Error(); :}
					      ;

StatementList ::=    (StatementList1) StatementList:S1 Statement:S2 {: RESULT=new StatementList1(S1, S2); RESULT.setLine(S1left); :}
				   | (EmptyStatementList1) {: RESULT=new EmptyStatementList1(); :}; // epsilon

Statement ::=  (StatementDesignatorStatement) DesignatorStatement:D1 SEMI {: RESULT=new StatementDesignatorStatement(D1); RESULT.setLine(D1left); :}
			 | (StatementIfElse) IF LEFT_ROUND_BRACKET Condition:C1 RIGHT_ROUND_BRACKET Statement:S2 StatementArrayBrackets:S3 {: RESULT=new StatementIfElse(C1, S2, S3); RESULT.setLine(C1left); :}
			 | (StatementIfElseError) IF LEFT_ROUND_BRACKET error:e {: parser.report_error("Oporavak od greske do ')' na liniji " + eleft, null); :} RIGHT_ROUND_BRACKET Statement:S1 StatementArrayBrackets:S2 {: RESULT=new StatementIfElseError(S1, S2); RESULT.setLine(S1left); :}
			 | (StatementBreak) BREAK SEMI {: RESULT=new StatementBreak(); :}
			 | (StatementContinue) CONTINUE SEMI {: RESULT=new StatementContinue(); :}
			 | (StatementReturnEmpty) RETURN SEMI {: RESULT=new StatementReturnEmpty(); :}
			 | (StatementReturnExpr) RETURN Expr:E1 SEMI {: RESULT=new StatementReturnExpr(E1); RESULT.setLine(E1left); :}
			 | (StatementRead) READ LEFT_ROUND_BRACKET Designator:D1 RIGHT_ROUND_BRACKET SEMI {: RESULT=new StatementRead(D1); RESULT.setLine(D1left); :}
			 | (StatementPrintExpr) PRINT LEFT_ROUND_BRACKET Expr:E1 RIGHT_ROUND_BRACKET SEMI {: RESULT=new StatementPrintExpr(E1); RESULT.setLine(E1left); :}
			 | (StatementPrintExprNumber) PRINT LEFT_ROUND_BRACKET Expr:E1 COMMA NUMBER:N2 RIGHT_ROUND_BRACKET SEMI {: RESULT=new StatementPrintExprNumber(E1, N2); RESULT.setLine(E1left); :}
			 | (StatementDoWhileCond) DoHelper:D1 Statement:S2 WhileHelper:W3 LEFT_ROUND_BRACKET Condition:C4 RIGHT_ROUND_BRACKET SEMI {: RESULT=new StatementDoWhileCond(D1, S2, W3, C4); RESULT.setLine(D1left); :}
			 | (StatementDoWhileEmpty) DoHelper:D1 Statement:S2 WhileHelper:W3 LEFT_ROUND_BRACKET RIGHT_ROUND_BRACKET SEMI {: RESULT=new StatementDoWhileEmpty(D1, S2, W3); RESULT.setLine(D1left); :}
			 | (StatementDoWhileCondDesStatement) DoHelper:D1 Statement:S2 WhileHelper:W3 LEFT_ROUND_BRACKET Condition:C4 COMMA DesignatorStatement:D5 RIGHT_ROUND_BRACKET SEMI {: RESULT=new StatementDoWhileCondDesStatement(D1, S2, W3, C4, D5); RESULT.setLine(D1left); :}			 
			 | (StatementStatementList) LEFT_CURLY_BRACKET StatementList:S1 RIGHT_CURLY_BRACKET {: RESULT=new StatementStatementList(S1); RESULT.setLine(S1left); :}
			 ;
			 
DoHelper ::= (DoHelper) DO {: RESULT=new DoHelper(); :}; // Helper for counting how many while loops we are entering

WhileHelper ::= (WhileHelper) WHILE {: RESULT=new WhileHelper(); :}; // Helper for processing continue

StatementArrayBrackets ::=   (StatementArrayBrackets1) ElseHelper:E1 Statement:S2 {: RESULT=new StatementArrayBrackets1(E1, S2); RESULT.setLine(E1left); :}
						   | (EmptyStatementArrayBrackets1) {: RESULT=new EmptyStatementArrayBrackets1(); :}; // epsilon

ElseHelper ::= (ElseHelper) ELSE {: RESULT=new ElseHelper(); :}; // Helper for 

Label ::= (Label) IDENT:I1 {: RESULT=new Label(I1); RESULT.setLine(I1left); :};

Condition ::= (Condition) ConditionCondTermList:C1 {: RESULT=new Condition(C1); RESULT.setLine(C1left); :};

ConditionCondTermList ::=   (ConditionCondTermListOr) ConditionCondTermList:C1 OR CondTerm:C2 {: RESULT=new ConditionCondTermListOr(C1, C2); RESULT.setLine(C1left); :}
				    	  | (ConditionCondTermListCondTerm) CondTerm:C1 {: RESULT=new ConditionCondTermListCondTerm(C1); RESULT.setLine(C1left); :}
				    	  ;

CondTerm ::= (CondTerm) CondTermCondFactList:C1 {: RESULT=new CondTerm(C1); RESULT.setLine(C1left); :};

CondTermCondFactList ::=   (CondTermCondFactListAnd) CondTermCondFactList:C1 AND CondFact:C2 {: RESULT=new CondTermCondFactListAnd(C1, C2); RESULT.setLine(C1left); :}
				    	 | (CondTermCondFactListCondFact) CondFact:C1 {: RESULT=new CondTermCondFactListCondFact(C1); RESULT.setLine(C1left); :}
				    	 ;

CondFact ::=   (CondFactExpr) Expr:E1 {: RESULT=new CondFactExpr(E1); RESULT.setLine(E1left); :}
			 | (CondFactRelopExpr) Expr:E1 Relop:R2 Expr:E3 {: RESULT=new CondFactRelopExpr(E1, R2, E3); RESULT.setLine(E1left); :}
			 ;
			 

DesignatorStatement ::=   (DesignatorAssignOperation) Designator:D1 Assignop:A2 Expr:E3 {: RESULT=new DesignatorAssignOperation(D1, A2, E3); RESULT.setLine(D1left); :}
						| (DesignatorStatementError) error:e
						  {: parser.report_error("Oporavak od greske do ; u DesignatorStatementu na liniji: " + eleft, null); :} {: RESULT=new DesignatorStatementError(); :}
                        | (DesignatorFunctionCallActPars) Designator:D1 LEFT_ROUND_BRACKET ActPars:A2 RIGHT_ROUND_BRACKET {: RESULT=new DesignatorFunctionCallActPars(D1, A2); RESULT.setLine(D1left); :}  // just a function call without assigning (f1();)
						| (DesignatorPostIncrement) Designator:D1 INC {: RESULT=new DesignatorPostIncrement(D1); RESULT.setLine(D1left); :}
						| (DesignatorPostDecrement) Designator:D1 DEC {: RESULT=new DesignatorPostDecrement(D1); RESULT.setLine(D1left); :}
						| (DesignatorAssignopSetop) Designator:D1 Assignop:A2 Designator:D3 Setop:S4 Designator:D5 {: RESULT=new DesignatorAssignopSetop(D1, A2, D3, S4, D5); RESULT.setLine(D1left); :}
						;

ActPars ::=   (ActParsExist) ActParsHelper:A1 ActPar:A2 ActParsExprList:A3 {: RESULT=new ActParsExist(A1, A2, A3); RESULT.setLine(A1left); :}
		    | (ActParsEmpty) {: RESULT=new ActParsEmpty(); :}; // epsilon, instead of writing inside DesignatorStatement and Factor, I moved those empty pars here

ActParsExprList ::=   (ActParsExprList1) ActParsExprList:A1 COMMA ActPar:A2 {: RESULT=new ActParsExprList1(A1, A2); RESULT.setLine(A1left); :}
				    | (EmptyActParsExprList1) {: RESULT=new EmptyActParsExprList1(); :}; // epsilon
				    
ActPar ::= (ActPar) Expr:E1 {: RESULT=new ActPar(E1); RESULT.setLine(E1left); :};

// Used to help with nested function calls inside function call
ActParsHelper ::= (ActParsHelper) {: RESULT=new ActParsHelper(); :}; // epsilon

Expr ::=   (ExprTerm) ExprAddopTermList:E1 {: RESULT=new ExprTerm(E1); RESULT.setLine(E1left); :}
		 | (ExprMap) Designator:D1 MAP Designator:D2 {: RESULT=new ExprMap(D1, D2); RESULT.setLine(D1left); :};

ExprAddopTermList ::=   (ExprAddopTermListAdd) ExprAddopTermList:E1 Addop:A2 Term:T3 {: RESULT=new ExprAddopTermListAdd(E1, A2, T3); RESULT.setLine(E1left); :}
				      | (ExprAddopTermListTerm) Term:T1 {: RESULT=new ExprAddopTermListTerm(T1); RESULT.setLine(T1left); :};

Term ::= (Term) TermMulopFactorList:T1 {: RESULT=new Term(T1); RESULT.setLine(T1left); :};

TermMulopFactorList ::=   (TermMulopFactorListMul) TermMulopFactorList:T1 Mulop:M2 Factor:F3 {: RESULT=new TermMulopFactorListMul(T1, M2, F3); RESULT.setLine(T1left); :}
					    | (TermMulopFactorListFactor) Factor:F1 {: RESULT=new TermMulopFactorListFactor(F1); RESULT.setLine(F1left); :};

Factor ::=   (FactorDesignator) Designator:D1 {: RESULT=new FactorDesignator(D1); RESULT.setLine(D1left); :}
		   | (FactorDesignatorMinus) MINUS Designator:D1 {: RESULT=new FactorDesignatorMinus(D1); RESULT.setLine(D1left); :}
		   | (FactorDesignatorActPars) Designator:D1 LEFT_ROUND_BRACKET ActPars:A2 RIGHT_ROUND_BRACKET {: RESULT=new FactorDesignatorActPars(D1, A2); RESULT.setLine(D1left); :} 	// assigning function call (i = f1();)
		   | (FactorNumConst) NUMBER:N1 {: RESULT=new FactorNumConst(N1); RESULT.setLine(N1left); :}
		   | (FactorNumConstMinus) MINUS NUMBER:N1 {: RESULT=new FactorNumConstMinus(N1); RESULT.setLine(N1left); :}
		   | (FactorCharConst) CHAR_CONST:C1 {: RESULT=new FactorCharConst(C1); RESULT.setLine(C1left); :}
		   | (FactorBoolConst) BOOL_CONST:B1 {: RESULT=new FactorBoolConst(B1); RESULT.setLine(B1left); :}
		   | (FactorNewExpr) NEW Type:T1 LEFT_SQUARE_BRACKET Expr:E2 RIGHT_SQUARE_BRACKET {: RESULT=new FactorNewExpr(T1, E2); RESULT.setLine(T1left); :}
		   | (FactorBracketExpression) LEFT_ROUND_BRACKET Expr:E1 RIGHT_ROUND_BRACKET {: RESULT=new FactorBracketExpression(E1); RESULT.setLine(E1left); :}
		   | (FactorBracketExpressionMinus) MINUS LEFT_ROUND_BRACKET Expr:E1 RIGHT_ROUND_BRACKET {: RESULT=new FactorBracketExpressionMinus(E1); RESULT.setLine(E1left); :}
		   ;
		   

Designator ::=   (DesignatorVar) IDENT:I1 {: RESULT=new DesignatorVar(I1); RESULT.setLine(I1left); :}
			   | (DesignatorElem) DesignatorArrayName:D1 LEFT_SQUARE_BRACKET Expr:E2 RIGHT_SQUARE_BRACKET {: RESULT=new DesignatorElem(D1, E2); RESULT.setLine(D1left); :}
			   ;
	
DesignatorArrayName ::= (DesignatorArrayName) IDENT:I1 {: RESULT=new DesignatorArrayName(I1); RESULT.setLine(I1left); :};   

Assignop ::= (Assignop) ASSIGNMENT {: RESULT=new Assignop(); :};

Addop ::=   (PlusOp) PLUS {: RESULT=new PlusOp(); :}
		  | (MinusOp) MINUS {: RESULT=new MinusOp(); :}
		  ;

Mulop ::=   (MultiplyOp) MULTIPLY {: RESULT=new MultiplyOp(); :}
		  | (DivideOp) DIVIDE {: RESULT=new DivideOp(); :}
		  | (ModuoOp) MODUO {: RESULT=new ModuoOp(); :}
		  ;

Relop ::=   (EqualOp) EQUAL {: RESULT=new EqualOp(); :}
		  | (NotEqualOp) NOT_EQUAL {: RESULT=new NotEqualOp(); :}
		  | (GreaterOp) GREATER {: RESULT=new GreaterOp(); :}
		  | (GreaterEqualOp) GREATER_EQUAL {: RESULT=new GreaterEqualOp(); :}
		  | (LessOp) LESS {: RESULT=new LessOp(); :}
		  | (LessEqualOp) LESS_EQUAL {: RESULT=new LessEqualOp(); :}
		  ;
		  
Setop ::= (Setop) UNION {: RESULT=new Setop(); :};



